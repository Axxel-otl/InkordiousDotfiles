#!/bin/bash

set -e

# git-pr
# Uso:
#   git switch <target>
#   git pr <source>

die() {
    echo "Error: $*" >&2
    exit 1
}

# Verificar que estamos dentro de un repositorio
git rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
    die "No estás dentro de un repositorio Git."

# Verificar argumentos
[[ $# -eq 1 ]] ||
    die "Uso: git pr <branch>"

source="$1"
target="$(git branch --show-current)"

[[ -n "$target" ]] ||
    die "No se pudo determinar la rama actual."

[[ "$source" != "$target" ]] ||
    die "La rama fuente y la rama destino son la misma."

# Verificar que la rama fuente existe
git rev-parse --verify --quiet "$source" >/dev/null ||
    die "La rama '$source' no existe localmente."

# Verificar GitHub CLI
command -v gh >/dev/null 2>&1 ||
    die "GitHub CLI ('gh') no está instalado."

# Verificar autenticación de gh
gh auth status >/dev/null 2>&1 ||
    die "GitHub CLI no está autenticado. Ejecuta: gh auth login"

# Verificar que existe origin
git remote get-url origin >/dev/null 2>&1 ||
    die "No existe un remote 'origin'."

echo "Pull Request:"
echo "  source: $source"
echo "  target: $target"
echo

# Mostrar commits que entrarían al PR
echo "Commits:"
git log --oneline "$target..$source" || true

echo

# Confirmar
read -rp "¿Crear Pull Request de '$source' -> '$target'? [Y/n] " answer
answer="${answer:-Y}"

case "$answer" in
    y|Y|yes|YES)
        ;;
    *)
        echo "Cancelado."
        exit 0
        ;;
esac

echo
echo "Pushing '$source'..."

# Publicar/actualizar la rama
git push -u origin "$source"

echo
echo "Creando Pull Request..."

gh pr create \
    --base "$target" \
    --head "$source"

echo
echo "Pull Request creado correctamente."
