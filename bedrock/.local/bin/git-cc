#!/bin/bash

git diff --cached --quiet && {
  echo "No hay cambios staged"
  exit 1
}

type=$(gum choose feat fix delete style docs chore) || exit 1

breaking=$(gum choose "no" "sí (BREAKING CHANGE)") || exit 1

scope=$(gum input --placeholder "scope (opcional)") || exit 1

message=$(gum write \
  --header "Mensaje del commit (opcional)" \
  --placeholder $'Escribe el mensaje completo...\n\nPuedes usar varias líneas y Markdown:\n- cambio 1\n- cambio 2\n\nDéjalo vacío si no necesitas mensaje.' \
  --width 80 \
  --height 12
) || exit 1

# Construir tipo
if [ "$breaking" = "sí (BREAKING CHANGE)" ]; then
  type="${type}!"
fi

# Construir cabecera
commit_msg="$type"

if [ -n "$scope" ]; then
  commit_msg="${commit_msg}(${scope})"
fi

# Agregar : solo si existe mensaje
if [ -n "$message" ]; then
  commit_msg="${commit_msg}: ${message}"
fi

# Crear commit firmado
git commit -S -m "$commit_msg" || {
  echo "Falló el commit (firma o configuración)"
  exit 1
}

# Verificar la firma
git verify-commit HEAD || {
  echo "Firma inválida"
  exit 1
}

echo "OK: $type"
