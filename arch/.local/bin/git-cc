#!/bin/bash

git diff --cached --quiet && {
  echo "No hay cambios staged"
  exit 1
}

type=$(gum choose feat fix delete style docs chore) || exit 1

breaking=$(gum choose "no" "sí (BREAKING CHANGE)") || exit 1

scope=$(gum input --placeholder "scope (opcional)") || exit 1

msg=$(gum input --placeholder "mensaje del commit") || exit 1

[[ -z "$msg" ]] && {
  echo "Mensaje vacío no permitido"
  exit 1
}

# Construir tipo con !
if [ "$breaking" = "sí (BREAKING CHANGE)" ]; then
  type="${type}!"
fi

# Construir subject
if [ -n "$scope" ]; then
  commit_subject="$type($scope): $msg"
else
  commit_subject="$type: $msg"
fi

# Escribir cuerpo multilínea
commit_body=$(gum write \
  --header "Cuerpo del commit (opcional)" \
  --placeholder $'Describe los cambios...\n\nPuedes usar Markdown:\n- cambio 1\n- cambio 2\n\nDéjalo vacío si no necesitas cuerpo.' \
  --width 80 \
  --height 12
) || exit 1

# Crear commit
if [ -n "$commit_body" ]; then
  git commit -S \
    -m "$commit_subject" \
    -m "$commit_body" || {
      echo "Falló el commit (firma o configuración)"
      exit 1
    }
else
  git commit -S \
    -m "$commit_subject" || {
      echo "Falló el commit (firma o configuración)"
      exit 1
    }
fi

# Verificar la firma
git verify-commit HEAD || {
  echo "Firma inválida"
  exit 1
}

echo "OK: $commit_subject"
