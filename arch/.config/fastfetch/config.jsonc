{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "auto",
        "source": "$(find \"$HOME/dotfiles/arch/.config/fastfetch/pngs\" -type f -name '*.png' -print 2>/dev/null | shuf -n 1)",
        "height": 18,
        "padding": {
            "right": 2
        }
    },

    "display": {
        "separator": "  ",
        "color": "white",
        "constants": [
            "\u001b[37m",
            "\u001b[38;5;16m",
            "\u001b[38;5;17m",
            "\u001b[38;5;18m"
        ]
    },

    "modules": [
        "break",

        {
            "type": "custom",
            "key": "╭───────────────────────────────────╮"
        },

        {
            "type": "custom",
            "format": "│ {$2}󰄛{$1}  アクセル"
        },

        {
            "type": "chassis",
            "key": "│ 󰇺  chassis",
            "format": "{3>22} │"
        },

        {
            "type": "os",
            "key": "│ {$4}󰻀{$1}  distro",
            "format": "{$4}{pretty-name>22}{$1} │"
        },

        {
            "type": "kernel",
            "key": "│ {$2}{$1}  kernel",
            "format": "{$2}{release>22}{$1} │"
        },

        {
            "type": "command",
            "key": "│   uptime",
            "text": "uptime -p | cut -d ' ' -f 2-",
            "format": "{>22} │"
        },

        {
            "type": "shell",
            "key": "│ {$2}{$1}  shell ",
            "format": "{$2}{pretty-name>22}{$1} │"
        },

        {
            "type": "packages",
            "key": "│   pkgs  ",
            "format": "{all>22} │"
        },

        {
            "type": "command",
            "key": "│ {$2}{$1}  user  ",
            "text": "echo $USER",
            "format": "{$2}{>22}{$1} │"
        },

        {
            "type": "command",
            "key": "│   hname ",
            "text": "hostnamectl hostname",
            "format": "{>22} │"
        },

        {
            "type": "display",
            "key": "│ {$3}󰍹{$1}  display",
            "format": "{$3}{1}x{2} @ {3}Hz [{7}]{$1} │"
        },

        {
            "type": "terminal",
            "key": "│ {$3}>_{$1}  terminal",
            "format": "{>22} │"
        },

        {
            "type": "wm",
            "key": "│ {$3}󱗃{$1}  wm",
            "format": "{$3}{2>22}{$1} │"
        },

        {
            "type": "custom",
            "key": "╰───────────────────────────────────╯"
        },

        "break",

        {
            "type": "custom",
            "key": "╭───────────────────────────────────╮"
        },

        {
            "type": "cpu",
            "key": "│ {$2}{$1}  cpu   ",
            "format": "{$2}{1} @ {7>22}{$1} │"
        },

        {
            "type": "gpu",
            "key": "│ {$2}󰊴{$1}  gpu   ",
            "format": "{$2}{1} {2>22}{$1} │"
        },

        {
            "type": "gpu",
            "key": "│ {$4}󰒋{$1}  driver",
            "format": "{$4}{3>22}{$1} │"
        },

        {
            "type": "memory",
            "key": "│ {$4}{$1}  memory",
            "format": "{$4}{1} / {2>22}{$1} │"
        },

        {
            "type": "command",
            "key": "│ {$2}󱦟{$1}  os age",
            "keyColor": "red",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); if [ \"$birth_install\" -gt 0 ]; then echo $(( (current - birth_install) / 86400 )) days; else echo unknown; fi",
            "format": "{>22} │"
        },

        {
            "type": "colors",
            "key": "│",
            "paddingLeft": 2,
            "symbol": "circle"
        },

        {
            "type": "custom",
            "key": "╰───────────────────────────────────╯"
        },

        "break"
    ]
}
